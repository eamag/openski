{
	"name": "openski",
	"version": "0.1.0",
	"private": true,
	"description": "openski.org — ski piste map, lift queues and conditions",
	"license": "AGPL-3.0-only",
	"homepage": "https://openski.org",
	"repository": "github:eamag/openski",
	"bugs": "https://github.com/eamag/openski/issues",
	"type": "module",
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "bun run gen --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --ip 127.0.0.1 --port 4173",
		"deploy": "bun run build && wrangler deploy",
		"deploy:prod": "bun run build && wrangler deploy --env production",
		"prepare": "svelte-kit sync || echo ''",
		"check": "bun run gen --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types --env-file .env.example --include-main-module=false",
		"data:catalog": "bun scripts/build-catalog.ts",
		"data:fetch": "bun scripts/data.ts fetch",
		"data": "bun scripts/data.ts build",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply taktiski --local",
		"db:migrate:dev": "wrangler d1 migrations apply taktiski --remote",
		"db:migrate:prod": "wrangler d1 migrations apply openski --remote --env production"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^8.0.3",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.6",
		"@types/suncalc": "^1.9.2",
		"auth": "^1.7.27",
		"better-auth": "^1.7.27",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"wrangler": "^4.166.0"
	},
	"dependencies": {
		"idb-keyval": "^6.3.0",
		"maplibre-contour": "^0.1.1",
		"maplibre-gl": "^6.19.0",
		"onnxruntime-web": "^1.31.1",
		"suncalc": "^2.1.4"
	}
}
