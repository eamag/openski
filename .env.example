# openski.org — sample environment, no secrets.
#
# Copy to .env for local Vite/SvelteKit development. Wrangler local Worker secrets go in
# .dev.vars instead. Both .env* and .dev.vars* are gitignored; never put real secrets in tracked files.
#
# The public map works with all variables empty; the settings below are only needed for
# OpenStreetMap sign-in, saving edits and the debug page.

# Public origin of the app without trailing slash (e.g. http://127.0.0.1:5173 for local dev; use 127.0.0.1 for OSM OAuth)
ORIGIN=""

# Better Auth secret used to sign session cookies (generate 32 random characters for production)
BETTER_AUTH_SECRET=""

# OpenStreetMap API base: dev server (https://master.apis.dev.openstreetmap.org) or production (https://api.openstreetmap.org)
OSM_API="https://master.apis.dev.openstreetmap.org"

# OpenStreetMap OAuth 2 client ID registered with scopes read_prefs and write_api, redirect <ORIGIN>/api/auth/callback/osm
OSM_CLIENT_ID=""

# OpenStreetMap OAuth 2 client secret
OSM_CLIENT_SECRET=""

# Server-side killswitch for OSM changeset saves ("true" or "1" to enable; disabled by default)
OSM_WRITES_ENABLED=""

# Comma-separated OSM user IDs or display names allowed to save changesets; empty or "*" allows all signed-in users
OSM_WRITES_ALLOWLIST=""

# Optional Open-Meteo commercial API key; empty uses the free endpoint (10,000 calls/day)
OPEN_METEO_API_KEY=""

# Optional Worker flag (in .dev.vars for local preview) to expose /dev/queues. Vite dev serves it by default.
ENABLE_DEV_ROUTES=""
